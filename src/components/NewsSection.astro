---
import { getApprovedNews, mediaUrl, formatDate, excerpt } from '../lib/api';
import { newsArticles as fallback } from '../data/news';

let newsArticles = fallback.map((a) => ({
  title: a.title,
  excerpt: a.excerpt,
  date: a.date,
  image: a.image,
  href: `/news/${a.slug}`,
}));

try {
  const apiNews = await getApprovedNews();
  if (apiNews.length) {
    newsArticles = apiNews.slice(0, 3).map((n: any) => ({
      title: n.title,
      excerpt: excerpt(n.description),
      date: formatDate(n.createdDate),
      image: mediaUrl(n.mediaPath),
      href: `/news/${n.id}`,
    }));
  }
} catch (e) {
  console.error('NewsSection API fallback:', e);
}
---

<section class="section">
  <div class="container">
    <h2 class="section__title">Latest News</h2>
    <div class="card-grid">
      {newsArticles.map((article) => (
        <article class="card">
          <div class="card__image">
            <img src={article.image} alt={article.title} />
          </div>
          <div class="card__body">
            <span class="card__date">{article.date}</span>
            <h3 class="card__title">{article.title}</h3>
            <p class="card__excerpt">{article.excerpt}</p>
            <a href={article.href} class="card__link">Read more</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
