---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEvents, mediaUrl, formatDate, excerpt } from '../lib/api';
import { events as fallback } from '../data/events';

export const prerender = false;

const apiEvents = await getEvents();
const events = apiEvents.length
  ? apiEvents.map((e: any) => ({
      title: e.title,
      excerpt: excerpt(e.description),
      date: formatDate(e.createdDate),
      image: mediaUrl(e.mediaPath),
      href: `/events/${e.id}`,
    }))
  : fallback.map((e) => ({
      title: e.title,
      excerpt: e.excerpt,
      date: e.date,
      image: e.image,
      href: `/events/${e.slug}`,
    }));
---

<BaseLayout title="Events" description="Upcoming events from Future Media.">
  <div class="page-hero">
    <div class="container">
      <h1>Events</h1>
      <p>Live experiences, expos, and community events from Future Media.</p>
    </div>
  </div>
  <div class="page-content">
    <div class="container">
      <div class="card-grid">
        {events.map((event) => (
          <article class="card">
            <div class="card__image">
              <img src={event.image} alt={event.title} />
            </div>
            <div class="card__body">
              <span class="card__date">{event.date}</span>
              <h3 class="card__title">{event.title}</h3>
              <p class="card__excerpt">{event.excerpt}</p>
              <a href={event.href} class="card__link">Read more</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
