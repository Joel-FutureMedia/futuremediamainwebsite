---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEventById, mediaUrl, formatDate } from '../../lib/api';
import { events } from '../../data/events';

export const prerender = false;

const { slug } = Astro.params;
const isNumeric = slug && /^\d+$/.test(slug);

let event: {
  title: string;
  excerpt: string;
  date: string;
  location?: string;
  image: string;
  content: string;
} | null = null;

if (isNumeric) {
  const e = await getEventById(slug!);
  if (e) {
    event = {
      title: e.title,
      excerpt: e.description,
      date: formatDate(e.createdDate),
      image: mediaUrl(e.mediaPath),
      content: `<p>${String(e.description || '').replace(/\n/g, '</p><p>')}</p>`,
    };
  }
} else {
  const found = events.find((a) => a.slug === slug);
  if (found) {
    event = {
      title: found.title,
      excerpt: found.excerpt,
      date: found.date,
      location: found.location,
      image: found.image,
      content: found.content,
    };
  }
}

if (!event) {
  return Astro.redirect('/');
}
---

<BaseLayout title={event.title} description={event.excerpt}>
  <div class="article-hero">
    <img src={event.image} alt={event.title} />
  </div>
  <div class="article-meta">
    <span class="article-meta__date">{event.date}{event.location ? ` · ${event.location}` : ''}</span>
    <h1>{event.title}</h1>
  </div>
  <div class="article-body" set:html={event.content} />
</BaseLayout>
