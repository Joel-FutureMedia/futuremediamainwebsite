---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEvents, mediaUrl, formatDate, excerpt } from '../../lib/api';
import { events as fallback } from '../../data/events';

export const prerender = true;

let events = fallback.map((e) => ({
  title: e.title,
  excerpt: e.excerpt,
  date: e.date,
  image: e.image,
  href: `/events/${e.slug}`,
}));

try {
  const apiEvents = await getEvents();
  if (apiEvents.length) {
    events = apiEvents.map((e: any) => ({
      title: e.title,
      excerpt: excerpt(e.description),
      date: formatDate(e.createdDate),
      image: mediaUrl(e.mediaPath),
      href: `/events/${e.id}`,
    }));
  }
} catch (e) {
  console.error('News/events page API fallback:', e);
}
---

<BaseLayout title="Events" description="Upcoming events from Future Media — expos, open days, workshops, and more.">
  <div class="page-hero">
    <div class="container">
      <h1>Events</h1>
      <p>Expos, open days, workshops, and live experiences from Future Media.</p>
    </div>
  </div>
  <div class="page-content">
    <div class="container">
      <div class="card-grid">
        {events.map((event) => (
          <article class="card">
            <div class="card__image">
              <img src={event.image} alt={event.title} />
            </div>
            <div class="card__body">
              <span class="card__date">{event.date}</span>
              <h3 class="card__title">{event.title}</h3>
              <p class="card__excerpt">{event.excerpt}</p>
              <a href={event.href} class="card__link">Read more</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
